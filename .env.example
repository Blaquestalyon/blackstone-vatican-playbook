# --- Blackstone Vatican Playbook · environment variables ---
# Copy to .env for local dev. On Railway, set these in the service Variables tab.

# Team access passcode. Anyone with this passcode can log in and change any status.
TEAM_PASSCODE=change-me-to-a-long-random-string

# Session cookie signing secret. Any long random string. Rotate to log everyone out.
SESSION_SECRET=change-me-to-another-long-random-string

# --- Airtable ---
# Personal Access Token (PAT) with data.records:read + data.records:write on the base below.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# The base ID (looks like appXXXXXXXXXXXXXX).
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Table names — must match the tables you (or Airtable AI) created.
AIRTABLE_TASK_STATE_TABLE=TaskState
AIRTABLE_AUDIT_LOG_TABLE=AuditLog

# Port (Railway sets PORT automatically; only needed for local dev).
PORT=3000
